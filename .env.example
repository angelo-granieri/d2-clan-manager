# Auth.js Secret (required) - Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_key_here

# Bungie API Credentials
# Get these from https://www.bungie.net/en/Application
AUTH_BUNGIE_ID=your_bungie_client_id_here
AUTH_BUNGIE_SECRET=your_bungie_client_secret_here

# Base Path (if deploying to a subdirectory)
BASE_PATH=
